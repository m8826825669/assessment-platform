# Use your local dedicated assessment database. Never commit real credentials.
# Before runtime provisioning this may be your local migration account.
ASSESSMENT_DATABASE_URL=postgresql+psycopg://assessment_dev:assessment_local_only@127.0.0.1:15432/assessment_dev
# create-runtime-role --write-env preserves the original URL here and switches DATABASE_URL.
# ASSESSMENT_MIGRATION_DATABASE_URL=postgresql+psycopg://migration_user:YOUR_PRIVATE_PASSWORD@127.0.0.1:5432/assessment
ASSESSMENT_DATABASE_CONNECT_TIMEOUT=3
ASSESSMENT_DATABASE_POOL_TIMEOUT=3
ASSESSMENT_DATABASE_STATEMENT_TIMEOUT_MS=5000
ASSESSMENT_SESSION_LIFETIME_SECONDS=3600
ASSESSMENT_LOGIN_WINDOW_SECONDS=300
ASSESSMENT_LOGIN_ACCOUNT_LIMIT=10
ASSESSMENT_LOGIN_IP_LIMIT=500
# Provision separately with create-worker-role --write-env; never reuse API or owner credentials.
# ASSESSMENT_WORKER_DATABASE_URL=postgresql+psycopg://assessment_worker:PRIVATE_PASSWORD@127.0.0.1:5432/assessment
ASSESSMENT_OUTBOX_LEASE_SECONDS=60
ASSESSMENT_OUTBOX_RETRY_BASE_SECONDS=2

# P2-005: private media is disabled until storage/scanner are provisioned.
# Local-only fixture settings; use TLS and independently managed credentials outside loopback.
ASSESSMENT_MEDIA_ENABLED=false
ASSESSMENT_MEDIA_ENDPOINT=127.0.0.1:19000
ASSESSMENT_MEDIA_SECURE=false
ASSESSMENT_MEDIA_REGION=us-east-1
ASSESSMENT_MEDIA_BUCKET=assessment-authoring
ASSESSMENT_MEDIA_SCANNER_HOST=127.0.0.1
ASSESSMENT_MEDIA_SCANNER_PORT=13310
ASSESSMENT_MEDIA_SIGNATURE_MAX_AGE_DAYS=7
# Provisioning writes generated ASSESSMENT_MEDIA_ACCESS_KEY / ASSESSMENT_MEDIA_SECRET_KEY privately.
